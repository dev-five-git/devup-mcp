"export interface StatusProps {
  status: 'success' | 'warning' | 'error'
}

export function Status({ status }: StatusProps) {
  return (
    <Image
      src={{
        success: "/icons/status=success.svg",
        warning: "/icons/status=warning.svg",
        error: "/icons/status=error.svg"
      }[status]}
    />
  )
}"
