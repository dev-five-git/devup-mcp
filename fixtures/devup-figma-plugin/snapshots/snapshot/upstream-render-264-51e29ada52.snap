"export interface CardProps {
  showBadge?: boolean
  showIcon?: boolean
}

export function Card({ showBadge, showIcon }: CardProps) {
  return (
    <Flex>
      {showBadge && <Box />}
      {showIcon && <Box />}
    </Flex>
  )
}"
