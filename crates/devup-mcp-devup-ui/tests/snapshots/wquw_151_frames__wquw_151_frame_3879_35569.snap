          <VStack borderTop="solid 1px $border" px="12px" py="20px">
            <VStack gap="4px">
              <Text color="$text" typography="h6" wordBreak="keep-all">
                교정 설정
              </Text>
              <Text color="$textLight" typography="bodyXs" wordBreak="keep-all">
                <Text typography="bodyXsSemibold">
                  이번 이야기
                </Text>
                에만 적용할 교정 방법을 설정해주세요.
              </Text>
            </VStack>
          </VStack>
          <Flex gap="10px" h="81px" p="12px" w="336px">
            <Box
              aspectRatio="1"
              bg="$primary"
              borderRadius="8px"
              boxSize="26px"
              maskImage="url(/icons/checkbox.svg)"
              maskPos="center"
              maskRepeat="no-repeat"
              maskSize="contain"
            />
            <VStack gap="2px" justifyContent="center">
              <Text color="$primary" typography="bodySemibold" wordBreak="keep-all">
                AI 담당자와 함께 문체 다듬기
              </Text>
              <Text color="$caption" typography="caption" wordBreak="keep-all">
                AI 담당자가 문맥을 자연스럽게 수정해요
              </Text>
            </VStack>
          </Flex>
          <Flex gap="10px" h="83px" p="12px" w="336px">
            <Box
              aspectRatio="1"
              bg="$gray200"
              borderRadius="8px"
              boxSize="26px"
              maskImage="url(/icons/checkbox.svg)"
              maskPos="center"
              maskRepeat="no-repeat"
              maskSize="contain"
            />
            <VStack gap="2px" justifyContent="center">
              <Text color="$text" typography="body" wordBreak="keep-all">
                내 문장 그대로 맞춤법만 다듬기
              </Text>
              <Text color="$caption" typography="caption" wordBreak="keep-all">
                입력하신 문장 그대로의 느낌을 담아내요
              </Text>
            </VStack>
          </Flex>
        </VStack>
      </Box>
    </VStack>
  );
}
